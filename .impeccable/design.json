  "narrative": {
    "northStar": "完善后设计稿 V6",
    "overview": "以用户选定的“完善后设计稿 V6”为视觉依据，以浅绿底、深绿字、薄荷信息卡与珊瑚主按钮承载生活取舍。原生微信导航环境与系统中文字体是这一方向的固有约束。\n\n这份文档从现有 WXSS 与三个原生组件提取视觉语言，用于后续界面的延展；它记录实现事实，不构成真机、截图一致性或可访问性验收。",
    "keyCharacteristics": [
      "浅绿背景与深绿文字形成基础层次。",
      "薄荷卡片聚合信息，珊瑚按钮提示主要行动。",
      "16 格顺时针棋盘是产品的识别图形。",
      "尺寸以原生 rpx 为准，390×844 为设计目标。"
    ],
    "rules": [
      {
        "name": "The V6 Rule",
        "body": "延展界面沿用用户选定 V6 的色彩角色；资源语义色不替代主按钮色。",
        "section": "colors"
      }
    ],
    "dos": [
      "Do 延续 V6 的浅绿、深绿、薄荷与珊瑚色角色。",
      "Do 使用原生微信组件、系统字体与安全区布局。",
      "Do 为棋盘保留 16 格顺时针路径和当前位置标识。",
      "Do 将源码提取、预览展示和真机验收明确区分。"
    ],
    "donts": [
      "Don't 用网页运行时或外部字体替换用户确认的原生实现。",
      "Don't 将尚未检查的效果、交互状态或尺寸适配写成已验收。",
      "Don't 将资源条中的健康、保障颜色提升为全局主要行动色。"
    ]
  }
}
