:host {
  display: block;
  width: 100%;
  min-width: 0;
}
/* 自定义组件样式隔离：显式清除微信原生 button 的默认宽度和边距。 */
view,
text,
button {
  box-sizing: border-box;
}
.board {
  position: relative;
  width: 100%;
  height: 0;
  /* 通过父容器宽度保持 1.1:1，无需依赖 aspect-ratio 或 Grid 支持。 */
  padding-bottom: 90.909091%;
  margin: 46rpx 0 28rpx;
}
.board > .tile {
  position: absolute;
  width: 18.8%;
  height: 18.8%;
  margin: 0;
  background: white;
  border: 2rpx solid #cfe2d4;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  padding: 16rpx 2rpx 8rpx;
  overflow: visible;
  color: #173f36;
  min-width: 0;
  min-height: 0;
  line-height: 1.4;
}
.tile::after {
  border: 0;
}
.number {
  position: absolute;
  top: 3rpx;
  left: 10rpx;
  font-size: 20rpx;
  color: #4f7064;
  font-weight: 400;
}
.name {
  font-size: 25rpx;
  font-weight: 700;
  white-space: nowrap;
}
.board > .asset {
  background: #cee8dc;
}
.board > .start {
  background: #f6d879;
}
.board > .current {
  border: 3rpx solid #2e806b;
}
.you {
  position: absolute;
  right: calc(50% - 25rpx);
  top: -23rpx;
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background: #ed5b46;
  color: white;
  font-size: 25rpx;
  line-height: 50rpx;
  z-index: 2;
}
.asset-line {
  position: absolute;
  bottom: 10rpx;
  width: 52rpx;
  height: 8rpx;
  background: #2e806b;
  border-radius: 8rpx;
}
.center {
  position: absolute;
  top: 20.3%;
  left: 20.3%;
  width: 59.4%;
  height: 59.4%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  pointer-events: none;
}
.center-title {
  font-size: 44rpx;
  font-weight: 750;
  line-height: 1.4;
}
.direction {
  font-size: 26rpx;
  color: #4f7064;
  margin: 18rpx 0 24rpx;
}
.legend {
  font-size: 23rpx;
  color: #4f7064;
  margin-top: 20rpx;
}
.house {
  position: relative;
  width: 88rpx;
  height: 72rpx;
  background: #2e806b;
  border-radius: 0 0 4rpx 4rpx;
  margin: 38rpx auto 0;
}
.house::before {
  content: "";
  position: absolute;
  left: -16rpx;
  top: -48rpx;
  border-left: 60rpx solid transparent;
  border-right: 60rpx solid transparent;
  border-bottom: 50rpx solid #2e806b;
}
.house::after {
  content: "";
  position: absolute;
  width: 26rpx;
  height: 49rpx;
  background: #fff4d6;
  bottom: 0;
  left: 31rpx;
  border-radius: 2rpx 2rpx 0 0;
}
.dice {
  width: 94rpx;
  height: 94rpx;
  border-radius: 20rpx;
  background: white;
  box-shadow: 0 6rpx 0 #c6dbcd;
  color: #2e806b;
  font-size: 60rpx;
  line-height: 94rpx;
  font-weight: 700;
  animation: roll 0.4s ease-out infinite alternate;
}
@keyframes roll {
  from {
    transform: rotate(-8deg);
  }
  to {
    transform: rotate(8deg);
  }
}
