<view class="header" style="padding-top: {{top}}px">
  <view
    class="nav"
    style="height: {{height}}px; padding-right: {{right}}px"
  >
    <button
      wx:if="{{!home}}"
      class="back"
      bindtap="back"
      aria-label="返回"
    >
      <view class="arrow"></view>
    </button>
    <text class="nav-title">{{title}}</text>
  </view>
</view>
