<view class="page">
  <app-header title="阶段回顾" />
  <view class="subtitle">
    第 {{game.round}} / 24 回合结束 · {{stageName}}
  </view>
  <view class="title">{{headline}}</view>
  <view class="card mint">
    <view class="card-title">阶段账本</view>
    <view class="body">
      现金 ¥{{report.before.cash}} → ¥{{report.after.cash}}
      <view>
        精力 {{report.before.energy}} → {{report.after.energy}} · 健康 {{report.before.health}} →
        {{report.after.health}}
      </view>
      <view>
        保障 {{report.before.protection}} → {{report.after.protection}} · 资产 {{assets.length}} 处
      </view>
    </view>
  </view>
  <view class="card">
    <view class="card-title">这六个回合</view>
    <view wx:for="{{choices}}" wx:key="index" class="body">
      {{item.title}}
    </view>
  </view>
  <view class="card">
    <view class="card-title">{{game.stage===4?'带向下一段人生':'带入下个阶段'}}</view>
    <view class="body">
      {{carry}}
      <view>下一步：给自己的选择留一些余地。</view>
    </view>
  </view>
  <view class="bottom-space"></view>
  <view class="dock">
    <view class="dock-inner">
      <button class="primary" bindtap="next">{{game.stage===4?'完成这局 · 查看人生回顾':'进入下一阶段 · '+nextStage}}</button>
    </view>
  </view>
</view>
